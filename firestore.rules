rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products — public read
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // CSR inquiries — anyone can create, only admins can read/update
    match /csr_inquiries/{id} {
      allow create: if true;
      allow read, update: if request.auth != null && request.auth.token.admin == true;
    }

    // Config (impact metrics, etc.) — public read, admin write
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Easter egg session logs — anyone can create, admin can read
    match /easter_egg_sessions/{id} {
      allow create: if true;
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Capitol encrypted chat — anyone (verified by server) can read/create.
    // Delete is open here because the role check is enforced in the client;
    // tighten this with a Cloud Function or custom claims if needed.
    match /capitol_chat/{id} {
      allow read, create: if true;
      allow delete: if true;   // client enforces admin-only UI
    }
  }
}
