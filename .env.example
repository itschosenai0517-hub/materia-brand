# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# App Config
VITE_APP_URL=https://materia.tw
VITE_APP_ENV=production

# ─── SERVER-SIDE ONLY (never prefix with VITE_) ────────────────────────────
# Capitol Terminal password — set in Railway/server environment variables only.
# This must NOT be exposed to the browser.
CAPITOL_SECRET=your_secret_capitol_password
